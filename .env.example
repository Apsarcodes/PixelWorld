# ==============================================================================
# PixelWorld Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# - Copy this file to `.env.local` for local development.
# - NEVER commit `.env` or `.env.local` with real secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS Core Secret (generate using `openssl rand -hex 32`)
PAYLOAD_SECRET=dev_insecure_payload_secret_must_be_changed_in_prod_32bytes

# Database Configuration (Supabase PostgreSQL / Local Postgres)
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/pixelworld

# YouPI-PG Payment Gateway (Development sandbox URL & API credentials)
# See: https://github.com/youpi-pg/YouPI-PG
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=pixelworld_dev_merchant
YOUPI_API_KEY=youpi_dev_api_key_test_only
YOUPI_WEBHOOK_SECRET=youpi_dev_webhook_secret_32bytes_min

# Cloudflare R2 / S3-Compatible Media Storage (Leave empty for local file storage in dev)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pixelworld-media
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=

# Security & Rate Limiting Controls
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW_MS=60000
